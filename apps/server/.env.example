# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kehai:kehai@localhost:5432/kehai_engine?schema=public"

# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_ORIGIN="http://localhost:3000"

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Google OAuth 2.0 (optional — leave blank to disable "Sign in with Google")
GOOGLE_CLIENT_ID=""

# ── AI (optional — leave blank to disable AI features; the rest of the
#    platform works fully without it). Groq: free tier, no credit card
#    required — get a key at https://console.groq.com/keys ────────────────
GROQ_API_KEY=""
AI_MODEL="openai/gpt-oss-120b"

# ── QR ──────────────────────────────────────────────────────────────────
# Global pepper mixed into every event's per-event QR signing secret.
QR_SIGNING_PEPPER="change-me-qr-pepper"
