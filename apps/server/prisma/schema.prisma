// Kehai Engine — core data model
// PostgreSQL. Geospatial handled via lat/lng float pairs + Haversine at the
// application layer (no PostGIS dependency needed at this scale, keeps the
// stack deployable anywhere).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String? // null when provider is GOOGLE-only
  provider     AuthProvider @default(PASSWORD)
  googleSub    String?      @unique
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships   Membership[]
  registrations Registration[]
  attendances   AttendanceRecord[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdEvents Event[]            @relation("EventCreatedBy")

  taughtClassrooms Classroom[]       @relation("ClassroomTeacher")
  enrollments      Enrollment[]      @relation("StudentEnrollments")
  classAttendances ClassAttendance[] @relation("StudentClassAttendance")

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Multi-tenancy: Organization -> Membership -> Event
// ─────────────────────────────────────────────────────────────────────────

enum OrgRole {
  OWNER
  ADMIN
  ORGANIZER
  VIEWER
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  events      Event[]
  auditLogs   AuditLog[]

  @@index([slug])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole  @default(ORGANIZER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Event {
  id             String @id @default(cuid())
  organizationId String
  createdById    String

  name        String
  description String?
  venue       String
  status      EventStatus @default(DRAFT)

  startsAt DateTime
  endsAt   DateTime

  // Registration window (optional; null = always open until event starts)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?

  // Attendance window: how early/late a scan is accepted relative to start/end
  attendanceOpensMinutesBefore Int @default(30)
  attendanceClosesMinutesAfter Int @default(30)

  capacity Int? // null = unlimited

  // Geofence
  latitude        Float
  longitude       Float
  geofenceRadiusM Int   @default(100)

  // QR lifecycle
  qrSecret          String // per-event signing secret for rotating QR tokens
  qrRotationSeconds Int     @default(20)
  qrRevoked         Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("EventCreatedBy", fields: [createdById], references: [id])
  registrations Registration[]
  attendances   AttendanceRecord[]
  auditLogs     AuditLog[]
  insightCache  AiInsightCache[]

  @@index([organizationId, status])
  @@index([startsAt])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendance AttendanceRecord?

  @@unique([eventId, userId])
  @@index([eventId])
}

// ─────────────────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────────────────

enum AttendanceMethod {
  QR_GEO
  MANUAL_OVERRIDE
}

model AttendanceRecord {
  id             String  @id @default(cuid())
  eventId        String
  userId         String
  registrationId String? @unique

  method AttendanceMethod @default(QR_GEO)

  // Location snapshot at check-in (not retained beyond privacy window at the
  // app layer — see PRIVACY.md). Coarsened to ~5 decimal places (~1.1m).
  latitude           Float
  longitude          Float
  accuracyMeters     Float?
  distanceMeters     Float
  locationConfidence String // "high" | "medium" | "low" — derived from GPS accuracy

  qrTokenJti String // jti of the QR token consumed, for replay auditing

  checkedInAt DateTime @default(now())

  overriddenById String? // organizer who manually marked attendance, if any

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId, checkedInAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Classrooms — a second, parallel feature: teacher-run classes tracking
// attendance across a semester of recurring class days, joined by a short
// human-readable code instead of an org invite. Geofence is optional here
// (see Classroom.latitude) since indoor GPS is often unreliable and a
// once-a-semester precise geofence requirement would be brittle for a
// class that meets every day.
// ─────────────────────────────────────────────────────────────────────────

model Classroom {
  id            String  @id @default(cuid())
  teacherId     String
  name          String
  courseCode    String?
  semesterLabel String?
  joinCode      String  @unique

  // Geofence is OPTIONAL for classrooms (nullable) — indoor GPS is often
  // unreliable, and unlike one-off events, requiring precise geofencing
  // for every single class day would be brittle. If latitude/longitude
  // are null, check-in skips the geofence check entirely and relies on
  // the rotating signed QR alone.
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User           @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@index([teacherId])
}

model Enrollment {
  id          String   @id @default(cuid())
  classroomId String
  studentId   String
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  attendances ClassAttendance[]

  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
}

enum ClassSessionStatus {
  OPEN
  CLOSED
}

model ClassSession {
  id          String             @id @default(cuid())
  classroomId String
  label       String? // optional teacher-chosen name ("Lecture", "Quiz") — a classroom can have any number of sessions per day
  date        DateTime // calendar day, stored at UTC midnight — used to bucket sessions for the heatmap, not a uniqueness key
  status      ClassSessionStatus @default(OPEN)

  qrSecret          String
  qrRotationSeconds Int    @default(20)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  classroom   Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  attendances ClassAttendance[]

  @@index([classroomId, date])
  @@index([classroomId, status])
}

model ClassAttendance {
  id           String @id @default(cuid())
  sessionId    String
  enrollmentId String
  studentId    String

  latitude           Float?
  longitude          Float?
  accuracyMeters     Float?
  distanceMeters     Float?
  locationConfidence String?
  qrTokenJti         String

  checkedInAt DateTime @default(now())

  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    User         @relation("StudentClassAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Audit log — lightweight, append-only trail for sensitive actions
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  eventId        String?
  actorUserId    String?
  action         String // e.g. "event.publish", "attendance.override"
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// AI insight cache — avoids recomputing/re-prompting for unchanged data
// ─────────────────────────────────────────────────────────────────────────

model AiInsightCache {
  id        String   @id @default(cuid())
  eventId   String
  kind      String // "post_event_report" | "insight_bullets" | "anomaly_scan"
  inputHash String // hash of the deterministic context fed to the model
  content   Json
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind, inputHash])
  @@index([eventId, kind])
}
