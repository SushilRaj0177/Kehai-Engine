# Local dev: read at build/dev time by Next.js. Fine for `next dev`.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Production/Docker: read at container *runtime* (see app/layout.tsx +
# components/ApiBaseSetter.tsx) so the API's URL doesn't need to be known
# when the image is built — set this instead of NEXT_PUBLIC_API_URL when
# deploying. If both are set, API_URL wins.
# API_URL="https://your-api.onrender.com"
